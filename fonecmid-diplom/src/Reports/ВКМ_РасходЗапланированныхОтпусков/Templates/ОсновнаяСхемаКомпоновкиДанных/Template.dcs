			</dcscor:item>
			<dcscor:item>
				<dcscor:use>false</dcscor:use>
				<dcscor:parameter>Маска</dcscor:parameter>
				<dcscor:value xsi:type="xs:string">20##</dcscor:value>
			</dcscor:item>
		</inputParameters>
	</parameter>
	<parameter>
