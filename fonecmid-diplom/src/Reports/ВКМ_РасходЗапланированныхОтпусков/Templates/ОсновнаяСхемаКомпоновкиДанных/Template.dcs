<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Сотрудник</dataPath>
			<field>Сотрудник</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Год</dataPath>
			<field>Год</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Запланировано</dataPath>
			<field>Запланировано</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Израсходовано</dataPath>
			<field>Израсходовано</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВКМ_ОтпускаСотрудниковОбороты.Сотрудник КАК Сотрудник,
	СУММА(ВКМ_ОтпускаСотрудниковОбороты.ДнейПриход) КАК Запланировано,
	СУММА(ВКМ_ОтпускаСотрудниковОбороты.ДнейРасход) КАК Израсходовано
ИЗ
	РегистрНакопления.ВКМ_ОтпускаСотрудников.Обороты(,,, Год = &amp;ПараметрГод) КАК ВКМ_ОтпускаСотрудниковОбороты
СГРУППИРОВАТЬ ПО
	ВКМ_ОтпускаСотрудниковОбороты.Сотрудник</query>
	</dataSet>
	<totalField>
		<dataPath>Запланировано</dataPath>
		<expression>Сумма(Запланировано)</expression>
		<group>Сотрудник</group>
	</totalField>
	<totalField>
		<dataPath>Израсходовано</dataPath>
		<expression>Сумма(Израсходовано)</expression>
		<group>Сотрудник</group>
	</totalField>
	<parameter>
