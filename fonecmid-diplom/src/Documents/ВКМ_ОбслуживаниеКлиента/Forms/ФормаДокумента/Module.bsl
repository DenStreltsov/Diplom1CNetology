
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ДанныеДляЭлементаСправочника = ВКМ_ДанныеДляЭлементаСправочника();
	Если Не Объект.Ссылка.Пустая() Тогда
		ЕстьИзменения = ВКМ_ПроверитьИзменения(ДанныеДляЭлементаСправочника);
    	Если Не ЕстьИзменения Тогда  		
    		Возврат;
    	КонецЕсли;
    	Преамбула = СтрШаблон("В заявке %1 изменения:", ТекущийОбъект);
    	//НоваяЗаявка = Ложь;	
	Иначе
		Преамбула = СтрШаблон("Создана новая заявка на обслуживание:");
		//НоваяЗаявка = Истина;
		ЗаполнитьЗначенияСвойств(ДанныеДляЭлементаСправочника, Объект);		
	КонецЕсли;
	
	ДанныеДляЭлементаСправочника.Преамбула = Преамбула;
	//ДанныеДляЭлементаСправочника.Новая = НоваяЗаявка;
	//ДанныеДляЭлементаСправочника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущийОбъект.Ссылка, "ДатаПроведенияРабот,ВремяНачалаРаботПлан,ВремяОкончанияРаботПлан,Специалист,Клиент,ОписаниеПроблемы");
	ВКМ_СоздатьЭлементСправочникаСУведомлениямиТелеграмБотуНаСервере(ДанныеДляЭлементаСправочника);
КонецПроцедуры

Функция ВКМ_ПроверитьИзменения(ДанныеДляЭлементаСправочника) Экспорт
	ЕстьИзменения = Ложь;
	СтарыеЗначения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Ссылка, "ДатаПроведенияРабот,ВремяНачалаРаботПлан,ВремяОкончанияРаботПлан,Специалист");
    Если СтарыеЗначения.ДатаПроведенияРабот <> Объект.ДатаПроведенияРабот Тогда
        ЕстьИзменения = Истина;
        ДанныеДляЭлементаСправочника.ДатаПроведенияРабот = Объект.ДатаПроведенияРабот; 
    КонецЕсли;
    Если СтарыеЗначения.ВремяНачалаРаботПлан <> Объект.ВремяНачалаРаботПлан Тогда
        ЕстьИзменения = Истина;
        ДанныеДляЭлементаСправочника.ВремяНачалаРаботПлан = Объект.ВремяНачалаРаботПлан; 
    КонецЕсли;
    Если СтарыеЗначения.ВремяОкончанияРаботПлан <> Объект.ВремяОкончанияРаботПлан Тогда
        ЕстьИзменения = Истина;
        ДанныеДляЭлементаСправочника.ВремяОкончанияРаботПлан = Объект.ВремяОкончанияРаботПлан; 
    КонецЕсли;
    Если СтарыеЗначения.Специалист <> Объект.Специалист Тогда
        ЕстьИзменения = Истина;
        ДанныеДляЭлементаСправочника.Специалист = Объект.Специалист;
    КонецЕсли;
    Возврат ЕстьИзменения;
КонецФункции

Функция ВКМ_ДанныеДляЭлементаСправочника()
	Результат = Новый Структура;
	//Результат.Вставить("Новая");
	Результат.Вставить("Преамбула");
	Результат.Вставить("Клиент");
	Результат.Вставить("ДатаПроведенияРабот");
	Результат.Вставить("ВремяНачалаРаботПлан");
	Результат.Вставить("ВремяОкончанияРаботПлан");
	Результат.Вставить("Специалист");
	Возврат Результат;
КонецФункции

Процедура ВКМ_СоздатьЭлементСправочникаСУведомлениямиТелеграмБотуНаСервере(ДанныеДляЭлементаСправочника)
	
	УведомлениеСсылка = Справочники.ВКМ_УведомленияТелеграмБотуДляОтправки.ВКМ_СоздатьЭлементСправочникаСУведомлениямиТелеграмБоту(ДанныеДляЭлементаСправочника);
	Если Не УведомлениеСсылка = Справочники.ВКМ_УведомленияТелеграмБотуДляОтправки.ПустаяСсылка() Тогда
		ТекстСообщения = СтрШаблон("Создано уведомление телеграм-боту");
	Иначе
		ТекстСообщения = СтрШаблон("Ошибка при создании уведомления телеграм-боту");
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
КонецПроцедуры

