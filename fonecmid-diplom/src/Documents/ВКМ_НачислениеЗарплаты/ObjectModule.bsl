КонецПроцедуры

Процедура ВКМ_СформироватьДвиженияПоВзаиморасчетамССотрудниками()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВКМ_Удержания.Сотрудник КАК Сотрудник,
		|	СУММА(ВКМ_Удержания.Показатель) - СУММА(ВКМ_Удержания.Результат) КАК Сумма
		|ИЗ
		|	РегистрРасчета.ВКМ_Удержания КАК ВКМ_Удержания
		|ГДЕ
		|	ВКМ_Удержания.Регистратор = &Ссылка
		|СГРУППИРОВАТЬ ПО
		|	ВКМ_Удержания.Сотрудник";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Записывать = Истина;
	Пока Выборка.Следующий() Цикл
		Движение = Движения.ВКМ_ВзаиморасчетыССотрудниками.Добавить();
		Движение.Период = Дата;
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		ЗаполнитьЗначенияСвойств(Движение,Выборка);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВКМ_СформироватьДвиженияПоОтпускамСотрудников(Отказ)
	// регистр ВКМ_ОтпускаСотрудников
	// Стандарт ИТС: если уже есть отказ (например, из проверок), не выполняем проведение
    Если Отказ Тогда
        Возврат;
    КонецЕсли;
    
    Попытка
        // Формируем набор записей
		НаборЗаписей = СформироватьДвиженияПоОтпускам(ЭтотОбъект);
        
        // Записываем движения в регистр
		НаборЗаписей.Записать();
		ТаблицаЗначений = НаборЗаписей.Выгрузить();
		
		Блокировка = Новый БлокировкаДанных;

		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ВКМ_ОтпускаСотрудников");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных = ТаблицаЗначений;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Сотрудник", "Сотрудник");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Год", "Год");

		Блокировка.Заблокировать();

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВКМ_ОтпускаСотрудниковОстатки.Сотрудник КАК Сотрудник,
		|	-СУММА(ВКМ_ОтпускаСотрудниковОстатки.ДнейОстаток) КАК ДнейОстаток,
		|	ВКМ_ОтпускаСотрудниковОстатки.Сотрудник.Представление КАК СотрудникПредставление
		|ИЗ
		|	РегистрНакопления.ВКМ_ОтпускаСотрудников.Остатки(&Период, Сотрудник В (&СотрудникиВОтпуске)
		|	И Год = &Год) КАК ВКМ_ОтпускаСотрудниковОстатки
		|ГДЕ
		|	ВКМ_ОтпускаСотрудниковОстатки.ДнейОстаток < 0
		|СГРУППИРОВАТЬ ПО
		|	ВКМ_ОтпускаСотрудниковОстатки.Сотрудник,
		|	ВКМ_ОтпускаСотрудниковОстатки.Сотрудник.Представление";
		
		СотрудникиВОтпуске = ТаблицаЗначений.ВыгрузитьКолонку("Сотрудник");
		Запрос.УстановитьПараметр("СотрудникиВОтпуске", СотрудникиВОтпуске);
		Запрос.УстановитьПараметр("Период", Новый Граница(МоментВремени(), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("Год", ТаблицаЗначений[0].Год);

		РезультатЗапроса = Запрос.Выполнить();

		Выборка = РезультатЗапроса.Выбрать();

		Пока Выборка.Следующий() Цикл
         	 ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
                    "Превышен лимит дней отпуска для сотрудника " + Выборка.СотрудникПредставление + 
                    " на дней: " + Выборка.ДнейОстаток,
                    ЭтотОбъект,
                    "ОтпускаСотрудников",
                    Неопределено
                );
              Отказ = Истина;
		КонецЦикла;

	Исключение
        Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = "Не удалось записать движения по отпускам: " + ОписаниеОшибки();
        Сообщение.Поле = "ОтпускаСотрудников";
        Сообщение.Сообщить();
        
        ЗаписьЖурналаРегистрации(
            "Ошибка проведения документа ВКМ_ГрафикОтпусков",
            УровеньЖурналаРегистрации.Ошибка,
            Метаданные.Документы.ВКМ_ГрафикОтпусков,
            Неопределено,
            ОписаниеОшибки()
        );
        
        Отказ = Истина;
    КонецПопытки;
  
КонецПроцедуры

Функция СформироватьДвиженияПоОтпускам(ДокументОбъект)
    
    НаборЗаписей = РегистрыНакопления.ВКМ_ОтпускаСотрудников.СоздатьНаборЗаписей();
    НаборЗаписей.Отбор.Регистратор.Установить(ДокументОбъект.Ссылка);
    
    // Используем Соответствие — ключи могут быть любыми
    СоответствиеАгрегации = Новый Соответствие;
    
    Для Каждого Строка Из ДокументОбъект.Начисления Цикл
        
        Если Не Строка.ВидРасчета = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.Отпуск Тогда
        	Продолжить;
        КонецЕсли;
        
        Если Не ЗначениеЗаполнено(Строка.Сотрудник) Тогда
            Продолжить;
        КонецЕсли;
        
        ГодПериода = 0;
        Если ЗначениеЗаполнено(Строка.ДатаНачала) И ЗначениеЗаполнено(Строка.ДатаОкончания) Тогда
            ГодПериода = Год(Строка.ДатаНачала);
        Иначе
            Продолжить;
        КонецЕсли;
        
        // Ключ может содержать любые символы — это нормально для Соответствия
        КлючАгрегации = Строка(Строка.Сотрудник.УникальныйИдентификатор()) + "|" + Строка(ГодПериода);
        
        СтароеЗначение = СоответствиеАгрегации.Получить(КлючАгрегации);
        Если СтароеЗначение <> Неопределено Тогда
            ТекущееКоличествоДней = СтароеЗначение + ВычислитьКоличествоДней(Строка.ДатаНачала, Строка.ДатаОкончания);
        Иначе
            ТекущееКоличествоДней = ВычислитьКоличествоДней(Строка.ДатаНачала, Строка.ДатаОкончания);
        КонецЕсли;
        
        СоответствиеАгрегации.Вставить(КлючАгрегации, ТекущееКоличествоДней);
        
    КонецЦикла;
    
    // Формируем записи в регистр
    Для Каждого Элемент Из СоответствиеАгрегации Цикл
        НоваяЗапись = НаборЗаписей.Добавить();
        МассивЧасти = СтрРазделить(Элемент.Ключ, "|");
        СсылкаСотрудника = Справочники.Пользователи.ПолучитьСсылку(Новый УникальныйИдентификатор(МассивЧасти[0]));
        ГодИзКлюча = Число(МассивЧасти[1]);
        
        НоваяЗапись.Сотрудник = СсылкаСотрудника;
        НоваяЗапись.Год = ГодИзКлюча;
        НоваяЗапись.Дней = Элемент.Значение;
        НоваяЗапись.Период = ДокументОбъект.Дата;
        НоваяЗапись.ВидДвижения = ВидДвиженияНакопления.Расход;
    КонецЦикла;
    
    Возврат НаборЗаписей;
    
КонецФункции

// -----------------------------------------------------------------------------
// Вспомогательная функция: считает количество календарных дней между датами
// Учитывает, что ДатаОкончания включается в отпуск (обычно так считают дни)
// -----------------------------------------------------------------------------
Функция ВычислитьКоличествоДней(ДатаНачала, ДатаОкончания)
    
    Если ДатаНачала > ДатаОкончания Тогда
        Возврат 0; // Или можно вызвать исключение, если это ошибка бизнес‑логики
    КонецЕсли;
    
    РазницаВСекундах = ДатаОкончания - ДатаНачала;
    КоличествоДней = Цел(РазницаВСекундах / 86400) + 1; // +1, чтобы включить обе даты
    
    Возврат КоличествоДней;
    
КонецФункции